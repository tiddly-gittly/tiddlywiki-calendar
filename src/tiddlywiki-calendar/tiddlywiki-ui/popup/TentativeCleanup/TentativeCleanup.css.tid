title: $:/plugins/linonetwo/tw-calendar/tiddlywiki-ui/popup/TentativeCleanup/Styles
tags: $:/tags/Stylesheet
type: text/vnd.tiddlywiki

.tw-calendar-tentative-cleanup-config {
	display: flex;
	align-items: center;
	flex-wrap: wrap;
	gap: 0.75rem;
}

.tw-calendar-tentative-cleanup-count strong {
	margin: 0 0.2em;
}

.tw-calendar-tentative-cleanup-modal .tc-modal {
	width: min(960px, calc(100vw - 2rem));
	max-width: 960px;
}

.tw-calendar-tentative-cleanup-toolbar {
	display: flex;
	justify-content: flex-start;
	gap: 0.75rem;
	margin-bottom: 0.75rem;
}

.tw-calendar-tentative-cleanup-layout {
	display: grid;
	grid-template-columns: minmax(240px, 0.9fr) minmax(300px, 1.4fr);
	gap: 1rem;
	min-height: 330px;
}

.tw-calendar-tentative-cleanup-list-pane,
.tw-calendar-tentative-cleanup-preview-pane {
	min-width: 0;
	border: 1px solid <<colour modal-border>>;
	border-radius: 6px;
	background: <<colour modal-background>>;
}

.tw-calendar-tentative-cleanup-list-pane {
	overflow-y: auto;
	max-height: min(58vh, 520px);
}

.tw-calendar-tentative-cleanup-row {
	display: flex;
	align-items: stretch;
	border-bottom: 1px solid <<colour very-muted-foreground>>;
}

.tw-calendar-tentative-cleanup-row:last-child {
	border-bottom: 0;
}

.tw-calendar-tentative-cleanup-row.is-previewing {
	background: <<colour tiddler-controls-foreground>>;
	color: <<colour background>>;
}

.tw-calendar-tentative-cleanup-checkbox {
	display: flex;
	align-items: center;
	padding: 0.75rem 0 0.75rem 0.8rem;
}

.tw-calendar-tentative-cleanup-row-button {
	display: flex;
	flex: 1 1 auto;
	min-width: 0;
	flex-direction: column;
	align-items: flex-start;
	gap: 0.2rem;
	padding: 0.65rem 0.8rem;
	text-align: start;
	color: inherit;
}

.tw-calendar-tentative-cleanup-row-title {
	width: 100%;
	overflow: hidden;
	font-weight: 600;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.tw-calendar-tentative-cleanup-row-time {
	font-size: 0.82em;
	opacity: 0.75;
}

.tw-calendar-tentative-cleanup-preview-pane {
	max-height: min(58vh, 520px);
	overflow: auto;
	padding: 1rem;
}

.tw-calendar-tentative-cleanup-preview-title {
	margin-top: 0;
}

.tw-calendar-tentative-cleanup-preview-fields {
	display: grid;
	grid-template-columns: max-content minmax(0, 1fr);
	gap: 0.4rem 0.8rem;
}

.tw-calendar-tentative-cleanup-preview-fields dt {
	font-weight: 600;
}

.tw-calendar-tentative-cleanup-preview-fields dd {
	margin: 0;
}

.tw-calendar-tentative-cleanup-preview-tags {
	display: flex;
	flex-wrap: wrap;
	gap: 0.3rem;
}

.tw-calendar-tentative-cleanup-preview-text {
	margin-top: 1rem;
	padding-top: 1rem;
	border-top: 1px solid <<colour very-muted-foreground>>;
}

.tw-calendar-tentative-cleanup-empty {
	display: grid;
	min-height: 160px;
	place-items: center;
	padding: 1rem;
	color: <<colour muted-foreground>>;
	text-align: center;
}

.tw-calendar-tentative-cleanup-delete {
	color: <<colour alert-highlight>>;
}

.tw-calendar-tentative-cleanup-delete-label {
	margin-right: 0.75rem;
}

@media (max-width: 700px) {
	.tw-calendar-tentative-cleanup-modal .tc-modal {
		width: calc(100vw - 1rem);
		margin: 0.5rem;
	}

	.tw-calendar-tentative-cleanup-layout {
		grid-template-columns: minmax(0, 1fr);
	}

	.tw-calendar-tentative-cleanup-list-pane,
	.tw-calendar-tentative-cleanup-preview-pane {
		max-height: 34vh;
	}

	.tw-calendar-tentative-cleanup-preview-fields {
		grid-template-columns: minmax(0, 1fr);
	}
}
