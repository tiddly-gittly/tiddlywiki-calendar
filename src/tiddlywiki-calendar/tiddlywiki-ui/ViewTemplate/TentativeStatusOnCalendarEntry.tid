title: $:/plugins/linonetwo/tw-calendar/calendar-widget/tiddlywiki-ui/ViewTemplate/TentativeStatusOnCalendarEntry
tags: $:/tags/ViewTemplate
list-after: $:/plugins/linonetwo/tw-calendar/calendar-widget/tiddlywiki-ui/ViewTemplate/EditTimeOnCalendarEntry

\whitespace trim
\procedure lingo-base() $:/plugins/linonetwo/tw-calendar/language/

<% if [all[current]field:calendarEntry[yes]] %>
  <$wikify name="tentativeStatusLabel" text="<<lingo Tentative/Status>>">
    <$wikify name="tentativeMarkLabel" text="<<lingo Tentative/Mark>>">
      <$wikify name="tentativeConfirmLabel" text="<<lingo Tentative/Confirm>>">
        <div class="tw-calendar-tentative-control">
          <% if [<currentTiddler>get[status]match[tentative]] %>
            <div class="tw-calendar-tentative-control-state tw-calendar-tentative-control-state--tentative">
              <span class="tw-calendar-tentative-control-icon" aria-hidden="true">{{$:/core/images/warning}}</span>
              <span class="tw-calendar-tentative-control-copy" role="status">
                <strong class="tw-calendar-tentative-control-title"><<tentativeStatusLabel>></strong>
                <span class="tw-calendar-tentative-control-description"><<lingo Tentative/Description>></span>
              </span>
              <$button
                class="tc-btn-invisible tw-calendar-tentative-control-button tw-calendar-tentative-control-confirm"
                tooltip=<<tentativeConfirmLabel>>
                aria-label=<<tentativeConfirmLabel>>
              >
                <span aria-hidden="true">{{$:/core/images/done-button}}</span>
                <span><<tentativeConfirmLabel>></span>
                <$action-deletefield $tiddler=<<currentTiddler>> status />
              </$button>
            </div>
          <% else %>
            <div class="tw-calendar-tentative-control-state tw-calendar-tentative-control-state--confirmed">
              <$button
                class="tc-btn-invisible tw-calendar-tentative-control-button tw-calendar-tentative-control-mark"
                tooltip=<<tentativeMarkLabel>>
                aria-label=<<tentativeMarkLabel>>
              >
                <span aria-hidden="true">{{$:/core/images/edit-button}}</span>
                <span><<tentativeMarkLabel>></span>
                <$action-setfield $tiddler=<<currentTiddler>> status="tentative" />
              </$button>
            </div>
          <% endif %>
        </div>
      </$wikify>
    </$wikify>
  </$wikify>
<% endif %>
